{
  "expo": {
    "name": "Naufal Farma",
    "slug": "naufal-farma-native",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "naufalfarma",
    "platforms": [
      "android"
    ],
    "newArchEnabled": true,
    "android": {
      "package": "com.naufalfarma.posmigration",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
